# Virtual Environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data files (we will add raw/cleaned data later, but keep them out of Git initially)
data/raw/*
data/cleaned/*
!data/raw/.gitkeep
!data/cleaned/.gitkeep

# Power BI files (often too large for GitHub)
*.pbix

# Secrets and environment variables
.env

# VS Code settings
.vscode/

# OS generated files
.DS_Store
Thumbs.db